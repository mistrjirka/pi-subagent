{
	"name": "@mistrjirka/pi-subagent",
	"version": "0.4.3",
	"description": "Profile-driven uncapped subagent runtime for Pi",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/mistrjirka/pi-subagent"
	},
	"scripts": {
		"test": "tsx --test test/*.test.ts",
		"typecheck": "tsc --noEmit",
		"check": "biome check . && tsc --noEmit && tsx --test test/*.test.ts",
		"preview": "tsx preview.ts"
	},
	"files": [
		"*.ts",
		"README.md",
		"SPEC.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "^0.84.0",
		"@earendil-works/pi-coding-agent": "^0.84.0",
		"typebox": "^1.3.6"
	},
	"dependencies": {
		"@everyx/pi-ui": "^1.2.0",
		"yaml": "^2.9.0"
	},
	"packageManager": "pnpm@11.3.0",
	"engines": {
		"node": ">=24"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@earendil-works/pi-ai": "^0.84.0",
		"@earendil-works/pi-coding-agent": "^0.84.0",
		"@earendil-works/pi-tui": "^0.84.0",
		"@types/node": "^26.1.1",
		"tsx": "^4.23.1",
		"typebox": "^1.3.6",
		"typescript": "^7.0.2"
	}
}
